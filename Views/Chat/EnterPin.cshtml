@model int

<style>
    .pin-page {
        max-width: 450px;
        margin: 80px auto;
        padding: 20px;
    }

    .pin-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 18px;
        padding: 35px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
    }

    .pin-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        border-radius: 16px;
        background: #212529;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .pin-card h2 {
        margin-bottom: 8px;
        font-weight: 700;
    }

    .pin-card p {
        color: #888;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .pin-input {
        width: 100%;
        height: 50px;
        border: 1px solid #ddd;
        border-radius: 11px;
        padding: 0 15px;
        text-align: center;
        font-size: 20px;
        letter-spacing: 5px;
        outline: none;
        box-sizing: border-box;
    }

        .pin-input:focus {
            border-color: #212529;
            box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.08);
        }

    .pin-button {
        width: 100%;
        height: 48px;
        margin-top: 15px;
        border: none;
        border-radius: 11px;
        background: #212529;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

        .pin-button:hover {
            background: #000;
        }

    .pin-error {
        color: #dc3545;
        font-size: 14px;
        margin-top: 15px;
    }
</style>


<div class="pin-page">

    <div class="pin-card">

        <div class="pin-icon">
            🔐
        </div>

        <h2>
            Acceder a la sala
        </h2>

        <p>
            Introduce el PIN para entrar a
            <strong>
                @ChatRoom.Controllers.ChatController.Rooms.GetValueOrDefault(Model)
            </strong>
        </p>


        <form method="post" action="/Chat/EnterPin">

            <input type="hidden"
                   name="room"
                   value="@Model" />

            <input type="password"
                   name="pin"
                   class="pin-input"
                   placeholder="••••"
                   maxlength="6"
                   required />

            <button type="submit"
                    class="pin-button">

                Entrar a la sala

            </button>

        </form>


        @if (ViewBag.Error != null)
        {
            <div class="pin-error">
                @ViewBag.Error
            </div>
        }

    </div>

</div>
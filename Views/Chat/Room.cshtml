@model int

<style>
    /* =========================
               CONTENEDOR PRINCIPAL
               ========================= */

    .chat-page {
        max-width: 950px;
        margin: 35px auto;
        padding: 0 20px;
    }

    /* =========================
               HEADER
               ========================= */

    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .chat-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #212529;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .chat-title h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
        color: #212529;
    }

    .chat-subtitle {
        margin: 3px 0 0;
        color: #888;
        font-size: 13px;
    }

    /* =========================
               INPUT AREA
               ========================= */

    .message-form {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .input-group-chat {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .chat-input-wrapper {
        position: relative;
        flex: 1;
    }

    .chat-input {
        width: 100%;
        height: 48px;
        border: 1px solid #ddd;
        border-radius: 11px;
        padding: 0 15px;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        background: #fafafa;
        box-sizing: border-box;
    }

        .chat-input:focus {
            border-color: #212529;
            background: white;
            box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.08);
        }

        .chat-input::placeholder {
            color: #aaa;
        }

    /* =========================
               BOTÓN ENVIAR
               ========================= */

    .send-button {
        height: 48px;
        padding: 0 22px;
        border: none;
        border-radius: 11px;
        background: #212529;
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .send-button:hover {
            background: #000;
            transform: translateY(-1px);
        }

        .send-button:active {
            transform: translateY(0);
        }

    /* =========================
               PANEL DEL CHAT
               ========================= */

    .chat-panel {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .panel-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

    .panel-icon {
        font-size: 18px;
    }

    /* =========================
               MENSAJES
               ========================= */

    #messages {
        height: 480px;
        overflow-y: auto;
        padding: 20px;
        background: #fafafa;
    }

    .message {
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        padding: 11px 14px;
        margin-bottom: 10px;
        animation: messageAppear 0.25s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
    }

    .message-user {
        font-size: 13px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 3px;
    }

    .message-text {
        font-size: 14px;
        color: #444;
        word-wrap: break-word;
    }

    /* =========================
               ANIMACIÓN
               ========================= */

    @@keyframes messageAppear {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
               SCROLLBAR
               ========================= */

    #messages::-webkit-scrollbar {
        width: 6px;
    }

    #messages::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 10px;
    }

    #messages::-webkit-scrollbar-track {
        background: transparent;
    }

    /* =========================
               RESPONSIVE
               ========================= */

    @@media (max-width: 768px) {

        .chat-page {
            margin: 20px auto;
            padding: 0 12px;
        }

        .input-group-chat {
            flex-direction: column;
            align-items: stretch;
        }

        .send-button {
            width: 100%;
        }

        .chat-title h1 {
            font-size: 22px;
        }

        #messages {
            height: 420px;
        }
    }
</style>


<div class="chat-page">

    <!-- HEADER -->

    <div class="chat-header">

        <div class="chat-title">

            <div class="chat-title-icon">
                💬
            </div>

            <div>

                <h1>
                    @ChatRoom.Controllers.ChatController.Rooms.GetValueOrDefault(Model)
                </h1>

                <p class="chat-subtitle">
                    Sala de chat
                </p>

            </div>

        </div>

    </div>


    <!-- FORMULARIO -->

    <div class="message-form">

        <div class="input-group-chat">

            <div class="chat-input-wrapper">

                <input type="text"
                       id="user"
                       class="chat-input"
                       placeholder="Tu usuario..." />

            </div>

            <div class="chat-input-wrapper">

                <input type="text"
                       id="message"
                       class="chat-input"
                       placeholder="Escribe un mensaje..." />

            </div>

            <button id="btnSend"
                    class="send-button">
                Enviar ➤
            </button>

        </div>

    </div>


    <!-- CHAT -->

    <div class="chat-panel">

        <div class="panel-header">

            <span class="panel-icon">
                💬
            </span>

            <h3>
                Mensajes
            </h3>

        </div>

        <div id="messages">
        </div>

    </div>

</div>


<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<script>

    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();


    /* =========================
       CONECTAR A LA SALA
       ========================= */

    connection.start()
        .then(() => {

            connection.invoke("AddToGroup", "@Model");

        })
        .catch((e) => console.error(e));


    /* =========================
       ENVIAR MENSAJE
       ========================= */

    function sendMessage() {

        let room = "@Model";

        let user = document.getElementById("user").value;

        let message = document.getElementById("message").value;


        // Evitar mensajes vacíos

        if (user.trim() === "" || message.trim() === "") {
            return;
        }


        connection.invoke("SendMessage", room, user, message)
            .catch((err) => console.error(err.toString()));


        // Limpiar el mensaje

        document.getElementById("message").value = "";

        // Volver al input del mensaje

        document.getElementById("message").focus();

    }


    /* =========================
       BOTÓN ENVIAR
       ========================= */

    document.getElementById("btnSend")
        .addEventListener("click", (event) => {

            event.preventDefault();

            sendMessage();

        });


    /* =========================
       ENTER PARA ENVIAR
       ========================= */

    document.getElementById("message")
        .addEventListener("keydown", (event) => {

            if (event.key === "Enter") {

                event.preventDefault();

                sendMessage();

            }

        });


    /* =========================
       RECIBIR MENSAJES
       ========================= */

    connection.on("ReceiveMessage", (user, message) => {

        var newMessage =
            '<div class="message">' +

            '<div class="message-user">' +
            user +
            '</div>' +

            '<div class="message-text">' +
            message +
            '</div>' +

            '</div>';


        document.getElementById("messages").innerHTML =
            newMessage +
            document.getElementById("messages").innerHTML;

    });

</script>
